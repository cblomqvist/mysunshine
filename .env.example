# MySunshine Environment Configuration Template
# Copy this file to .env and configure your endpoints and private tokens.
# Do NOT commit .env to version control!

# ==========================================
# 1. Price Providers (External APIs)
# ==========================================

# ENTSO-E Transparency Platform API
# See https://transparency.entsoe.eu/
ENTSOE_API_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_API_KEY=your_entsoe_token_here

# Tibber GraphQL API
# See https://developer.tibber.com/
TIBBER_API_URL=https://api.tibber.com/v1-beta/gql
TIBBER_API_TOKEN=your_tibber_token_here

# Elering Public Spot Price API
ELERING_API_URL=https://dashboard.elering.ee/api/nps/price

# Energy-Charts (Fraunhofer ISE) API
ENERGY_CHARTS_API_URL=https://api.energy-charts.info

# ==========================================
# 2. Local Hardware & Hub Endpoints
# ==========================================

# Home Assistant Green
HA_URL=http://192.168.3.138:8123
HA_TOKEN=your_home_assistant_long_lived_token_here

# SonnenBatterie 10 Local API
SONNEN_URL=http://192.168.3.125
SONNEN_API_TOKEN=your_sonnen_token_here

# SMA Inverter Webconnect
SMA_URL=http://192.168.3.61
